{
  "name": "javier-garrido",
  "version": "1.12.0",
  "private": true,
  "description": "Source of javiergarrido.dev",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npx serve out",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "deploy": "gh-pages -d out -t",
    "release": "semantic-release",
    "release:dry": "semantic-release --no-ci -d",
    "commit": "git-cz",
    "svgr": "svgr -d src/icons/ src/assets/icons",
    "prepare": "husky"
  },
  "dependencies": {
    "i18next": "26.4.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@svgr/cli": "8.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "commitizen": "4.3.2",
    "cz-customizable": "7.5.4",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "gh-pages": "6.3.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "semantic-release": "25.0.9"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
